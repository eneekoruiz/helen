# -------------------------------------------------------------
# CONFIGURACIÓN DEL ASISTENTE PERSONAL (TELEGRAM + IA + GOOGLE)
# -------------------------------------------------------------

# 1. API Key de Google Gemini (Obtenla gratis en: https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. Token de tu bot de Telegram (Créalo hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# 3. Tu ID numérico de Telegram (para que el bot SOLO te responda a ti por seguridad)
#    Obtén tu ID enviando un mensaje a @userinfobot en Telegram.
#    Puedes poner varios separados por comas: ej. 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=123456789

# 4. Voz en español para las respuestas en audio (Edge-TTS, alta calidad y gratuito)
#    Opciones recomendadas:
#    - es-ES-AlvaroNeural (Masculina España)
#    - es-ES-ElviraNeural (Femenina España)
#    - es-MX-DaliaNeural  (Femenina México)
#    - es-MX-JorgeNeural  (Masculina México)
VOICE_NAME=es-ES-AlvaroNeural

# 5. Modelo de Gemini (por defecto el más rápido y multimodal)
GEMINI_MODEL=gemini-2.5-flash
