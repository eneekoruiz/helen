{
  "name": "helen-cli",
  "version": "2.1.0",
  "description": "HELEN — AI agent workflow kit: phase prompts, agent skills, playbooks and a vetted tool catalog, plus React + Vite + TypeScript scaffolding.",
  "type": "module",
  "bin": {
    "helen": "dist/cli.js",
    "helen-cli": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eneekoruiz/helen.git"
  },
  "bugs": {
    "url": "https://github.com/eneekoruiz/helen/issues"
  },
  "homepage": "https://github.com/eneekoruiz/helen#readme",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "templates",
    "skills",
    "docs",
    "!docs/archive",
    "evals/*.json",
    "evals/README.md",
    "scripts/run-skill-evals.mjs",
    "scripts/lib",
    "scripts/run-repo-evals.mjs",
    "scripts/run-specialty-evals.mjs",
    "scripts/review-specialty-rubric.mjs",
    "scripts/import-specialty-outcomes.mjs",
    "!docs/ECC-LOCAL-SKILLS-*.json",
    "!docs/AUDIT-*.md",
    "!docs/CIERRE-*.md",
    "!docs/IDEAS-100.md",
    "!docs/REPORT-*.md",
    "!docs/FINAL-VERIFICATION-*.md",
    "!docs/IMPROVEMENTS-*.md",
    "!docs/FOLLOWUP*.md",
    "!docs/QUALITY-*.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:json": "vitest run --reporter=json --outputFile=test-results.json",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\"",
    "evals": "node scripts/run-skill-evals.mjs --concurrency 8",
    "evals:repo": "node scripts/run-repo-evals.mjs",
    "evals:specialty": "node scripts/run-specialty-evals.mjs",
    "evals:review": "node scripts/review-specialty-rubric.mjs",
    "outcomes:import": "node scripts/import-specialty-outcomes.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prompt:powerpoint": "node dist/cli.js prompts show presentaciones --cache-ready",
    "prepare": "node -e \"const {spawnSync}=require('node:child_process');const path=require('node:path');const fs=require('node:fs');const realpath=fs.realpathSync.native||fs.realpathSync;const opts={encoding:'utf8',windowsHide:true,timeout:5000};const root=spawnSync('git',['rev-parse','--show-toplevel'],opts);if(process.env.npm_config_ignore_scripts!=='true'&&root.status===0&&path.relative(realpath(process.cwd()),realpath(root.stdout.trim()))===''){const current=spawnSync('git',['config','--get','core.hooksPath'],opts);const value=(current.stdout||'').replace(/\\r?\\n$/,'');if(current.status===1||(current.status===0&&value!==''&&path.resolve(value)===path.resolve('.githooks'))){const result=spawnSync('git',['config','--local','core.hooksPath','.githooks'],opts);if(result.error||result.status!==0){console.error(result.stderr||String(result.error));process.exitCode=1;}}}\"",
    "docs:check": "tsc && node scripts/docs-facts.mjs check",
    "docs:sync": "tsc && node scripts/docs-facts.mjs sync",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run test"
  },
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "agents",
    "ai",
    "skills",
    "prompts",
    "playbooks",
    "guardrails",
    "scaffolding",
    "dx"
  ],
  "author": "eneekoruiz",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clack/prompts": "^0.11.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.1",
    "glob": "^11.0.0",
    "handlebars": "^4.7.10",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "types": "./dist/index.d.ts"
}
