{
  "name": "helen-cli",
  "version": "2.0.0",
  "description": "HELEN — AI agent workflow kit: phase prompts, agent skills, playbooks and a vetted tool catalog, plus React + Vite + TypeScript scaffolding.",
  "type": "module",
  "bin": {
    "helen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "skills",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\"",
    "evals": "node scripts/run-skill-evals.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "setup",
    "boilerplate",
    "docker",
    "ci",
    "seo",
    "security",
    "dx"
  ],
  "author": "eneekoruiz",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.1",
    "glob": "^11.0.0",
    "handlebars": "^4.7.9",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
