{
  "name": "helen-cli",
  "version": "1.0.0",
  "description": "HELEN — Project setup CLI for React + Vite + TypeScript. Modular, interactive, safe.",
  "type": "module",
  "bin": {
    "helen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "setup",
    "boilerplate",
    "docker",
    "ci",
    "seo",
    "security",
    "dx"
  ],
  "author": "eneekoruiz",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.5",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
